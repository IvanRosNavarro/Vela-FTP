{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@vela-ftp/shared": ["../../shared/src/index.ts"],
      "@vela-ftp/shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
