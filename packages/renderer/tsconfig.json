{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@vela-ftp/shared": ["../../shared/src/index.ts"],
      "@vela-ftp/shared/*": ["../../shared/src/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*"]
}
