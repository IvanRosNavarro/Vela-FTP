{
  "name": "vela-ftp",
  "version": "1.9.0",
  "private": true,
  "description": "Vela FTP — cliente FTP, FTPS y SFTP de escritorio de la familia Vela",
  "author": {
    "name": "Iván Ros",
    "email": "it@tcgfactory.com"
  },
  "license": "GPL-3.0-only",
  "main": "packages/main/dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "dev": "concurrently --kill-others-on-fail --names \"renderer,preload,transfer,main,electron\" --prefix-colors \"cyan,yellow,blue,magenta,green\" \"pnpm --filter @vela-ftp/renderer dev\" \"pnpm --filter @vela-ftp/preload dev\" \"pnpm --filter @vela-ftp/transfer dev\" \"pnpm --filter @vela-ftp/main dev\" \"pnpm run dev:electron\"",
    "dev:electron": "wait-on tcp:5183 file:packages/main/dist/index.js file:packages/preload/dist/index.js file:packages/transfer/dist/index.js && electron .",
    "clean": "pnpm -r --parallel clean && rimraf node_modules",
    "kit:link": "node scripts/kit-link.mjs link",
    "kit:unlink": "node scripts/kit-link.mjs unlink",
    "test": "pnpm -r --parallel --if-present test",
    "build:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win",
    "build:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac",
    "build:linux": "pnpm build && electron-builder --config electron-builder.config.cjs --linux",
    "icon": "electron scripts/generate-icon.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "concurrently": "8.2.2",
    "dmg-builder": "26.15.3",
    "electron": "42.11.4",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "rimraf": "5.0.7",
    "typescript": "5.4.5",
    "wait-on": "7.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild"
    ],
    "overrides": {
      "electron-builder-squirrel-windows": "26.15.3",
      "dompurify@<3.4.13": "3.4.13"
    }
  },
  "dependencies": {
    "basic-ftp": "6.2.1",
    "electron-updater": "6.8.9",
    "ssh2": "1.17.0"
  },
  "productName": "Vela FTP"
}
